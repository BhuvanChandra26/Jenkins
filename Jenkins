pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh '''
                    echo "Compiling hello.java..."
                    javac hello.java
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    echo "Running Test..."
                    # Run the Java program (optional)
                    java hello || true
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    echo "Deploy step executing..."
                    echo "Build successful. Deploying application..."
                '''
            }
        }
    }
}
